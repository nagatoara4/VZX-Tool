# Keep simulation mode until official integrations are implemented and reviewed.
EXECUTION_MODE=simulation
COMMERCE_DB_PATH=commerce.db

# Required for all mutating owner endpoints. Generate a long random secret.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Policy defaults
LOSS_LIMIT_PCT=0.30
REINVESTMENT_PCT=0.80
DEFAULT_ACTION_CAP=25.00

# Required for signed multi-user session tokens; use a cryptographically random secret >= 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Token lifetime in seconds
TOKEN_TTL_SECONDS=86400

# Optional provider credentials are detection flags only in this release.
# Payment, marketplace and shipping execution is disabled until reviewed adapters are implemented.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_LWA_CLIENT_ID=
AMAZON_SP_API_LWA_CLIENT_SECRET=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# Official-provider adapter readiness only. Never store raw card details.
REDOTPAY_APP_KEY=
REDOTPAY_PRIVATE_KEY_PATH=
REDOTPAY_PLATFORM_PUBLIC_KEY_PATH=
REDOTPAY_LIVE_ENABLED=false
STRIPE_LIVE_ENABLED=false
PAYPAL_LIVE_ENABLED=false
AMAZON_SP_API_LIVE_ENABLED=false
